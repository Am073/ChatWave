# =============================================================================
# ChatWave MERN Configuration — Environment Variables
# =============================================================================

# Port for the Express backend
PORT=5000

# MongoDB Connection String (Mongoose)
MONGO_URI=mongodb://localhost:27017/chatwave_db

# Security Secrets (Must be at least 16/32 characters)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
CSRF_SECRET=your_csrf_secret_here

# Gemini API Settings (Single Key & Configurable Model)
# Supported options: gemini-2.0-flash, gemini-2.5-flash, gemini-3.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Google OAuth (Calendar Integration)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Environment & URLs
NODE_ENV=development
FRONTEND_URL=http://localhost:5173