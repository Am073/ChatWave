PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/chatwave
JWT_SECRET=<random_64_char_hex>
JWT_REFRESH_SECRET=<random_64_char_hex>
CSRF_SECRET=<random_32_char_hex>
GEMINI_API_KEY=
# Gemini model selection. Supported: gemini-2.0-flash, gemini-2.5-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-2.0-flash
QDRANT_URL=https://<cluster-id>.qdrant.io
QDRANT_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
