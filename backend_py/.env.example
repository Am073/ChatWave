APP_ENV=development
BACKEND_PORT=8000

# Generate unique values for local development:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production secrets MUST be at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
CSRF_SECRET=replace-with-another-random-secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Databases (cloud) ---
MONGO_URI=mongodb://localhost:27017/chatwave

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=cw_
EMBEDDING_DIM=768

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- LLM providers (at least one required in production) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Default model — admin can switch this at runtime if ALLOW_RUNTIME_MODEL_SWITCH=true
CHAT_MODEL=gemini/gemini-2.0-flash
EMBEDDING_MODEL=gemini/embedding-001
ALLOW_RUNTIME_MODEL_SWITCH=true
MAX_COMPLETION_TOKENS=2048

# --- Langfuse (optional observability) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173
ADDITIONAL_CORS_ORIGINS=[]

# --- Upload limits ---
MAX_UPLOAD_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg,image/webp

# --- Agent config ---
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=5
RETRIEVAL_TOP_K=5
USE_HYBRID_FILTER=true
PROMPT_VERSION=v2.0

# --- Rate limiting (Redis-backed sliding window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- Google Calendar OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback
