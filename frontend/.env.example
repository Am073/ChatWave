# Frontend env vars — copy to .env (gitignored).
# VITE_API_BASE_URL: where the FastAPI backend lives.
#   - empty / unset in production behind the same origin (nginx proxies /api)
#   - http://localhost:8000 in local dev
VITE_API_BASE_URL=http://localhost:8000

# VITE_DEMO_MODE: set to "true" to show seeded demo-account auto-fill on the
# login page (recruiter demos). Leave unset in production builds.
# VITE_DEMO_MODE=true
